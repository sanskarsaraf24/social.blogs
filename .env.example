# Blog Automation — Environment Variables
# Copy this to .env and fill in your values

# Groq AI (Content Agent + Image Agent)
GROQ_API_KEY=your_groq_api_key_here

# Tavily (Agentic Web Research)
TAVILY_API_KEY=your_tavily_api_key_here

# MongoDB (Isolated blog_automation database)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=blog_automation

# Server
PORT=3300
NODE_ENV=production
BASE_URL=https://social.minpay.in/blog

# Blog deployment paths on VPS (same machine — direct fs.copyFile)
SARAF_BLOG_PATH=/home/sanskarsaraf.in/public_html/blog/posts
CASEMATE_BLOG_PATH=/home/casemate.co.in/public_html/blog/posts

# Public URL base for header images
IMAGE_BASE_URL=https://social.minpay.in/blog/uploads/blog-headers
